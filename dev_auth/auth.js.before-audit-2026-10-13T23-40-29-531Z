const path = require('node:path');
const fs = require('node:fs');
const bcrypt = require('bcrypt');
const jwt = require('jsonwebtoken');
const { DatabaseSync } = require('node:sqlite');
const { rateLimit } = require('express-rate-limit');

if (!process.env.JWT_SECRET || process.env.JWT_SECRET.length < 32) {
  throw new Error('JWT_SECRET absent ou trop court dans secrets/.env');
}

fs.mkdirSync(path.join(__dirname, 'data'), { recursive: true });

const db = new DatabaseSync(path.join(__dirname, 'data', 'users.sqlite'));
db.exec(`
  CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    phone TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )
`);

// Migration compatible avec la base des utilisateurs existante.
try {
  db.exec("ALTER TABLE users ADD COLUMN role TEXT NOT NULL DEFAULT 'user' CHECK (role IN ('user', 'admin'))");
} catch (error) {
  if (!String(error.message).includes('duplicate column name')) throw error;
}


db.exec(`
  CREATE TABLE IF NOT EXISTS daily_usage (
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    usage_date TEXT NOT NULL,
    free_used INTEGER NOT NULL DEFAULT 0 CHECK (free_used >= 0),
    rewarded_used INTEGER NOT NULL DEFAULT 0 CHECK (rewarded_used >= 0),
    PRIMARY KEY (user_id, usage_date)
  );
  CREATE TABLE IF NOT EXISTS reward_credits (
    user_id INTEGER PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    credits INTEGER NOT NULL DEFAULT 0 CHECK (credits >= 0)
  );
`);

const COOKIE = 'zouzoua_session';
const SESSION_MS = 8 * 60 * 60 * 1000;
const cookieOptions = {
  httpOnly: true,
  secure: process.env.NODE_ENV === 'production',
  sameSite: 'strict',
  path: '/',
  maxAge: SESSION_MS
};

const authLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  limit: 8,
  standardHeaders: true,
  legacyHeaders: false,
  message: { error: 'Trop de tentatives. Réessaie dans 15 minutes.' }
});

function issueSession(res, user) {
  const token = jwt.sign(
    { sub: String(user.id), phone: user.phone },
    process.env.JWT_SECRET,
    { expiresIn: '8h', issuer: 'zouzoua-pronostic' }
  );
  res.cookie(COOKIE, token, cookieOptions);
}

function readToken(req) {
  const header = req.headers.cookie || '';
  const item = header.split(';').map(s => s.trim())
    .find(s => s.startsWith(COOKIE + '='));
  if (!item) return null;
  try {
    return decodeURIComponent(item.slice(COOKIE.length + 1));
  } catch {
    return null;
  }
}

function requireAuth(req, res, next) {
  const token = readToken(req);
  if (!token) return res.status(401).json({ error: 'Connexion requise.' });

  try {
    const payload = jwt.verify(token, process.env.JWT_SECRET, {
      issuer: 'zouzoua-pronostic'
    });
    const userId = Number(payload.sub);
    const user = db.prepare(
      'SELECT id, phone, role FROM users WHERE id = ?'
    ).get(userId);

    if (!user) {
      res.clearCookie(COOKIE, { ...cookieOptions, maxAge: undefined });
      return res.status(401).json({ error: 'Compte introuvable. Reconnecte-toi.' });
    }

    // Le rôle provient de SQLite, jamais d'une valeur envoyée par le navigateur.
    req.user = {
      id: Number(user.id),
      phone: user.phone,
      role: user.role
    };
    next();
  } catch {
    res.clearCookie(COOKIE, { ...cookieOptions, maxAge: undefined });
    return res.status(401).json({ error: 'Session expirée. Reconnecte-toi.' });
  }
}


function releaseAnalysisQuota(userId, day, kind) {
  db.exec('BEGIN IMMEDIATE');
  try {
    if (kind === 'free') {
      db.prepare(`
        UPDATE daily_usage
        SET free_used = CASE WHEN free_used > 0 THEN free_used - 1 ELSE 0 END
        WHERE user_id = ? AND usage_date = ?
      `).run(userId, day);
    } else {
      db.prepare(`
        UPDATE daily_usage
        SET rewarded_used = CASE WHEN rewarded_used > 0 THEN rewarded_used - 1 ELSE 0 END
        WHERE user_id = ? AND usage_date = ?
      `).run(userId, day);
      db.prepare(`
        INSERT INTO reward_credits (user_id, credits) VALUES (?, 1)
        ON CONFLICT(user_id) DO UPDATE SET credits = credits + 1
      `).run(userId);
    }
    db.exec('COMMIT');
  } catch (error) {
    try { db.exec('ROLLBACK'); } catch {}
    console.error('Impossible de restituer une utilisation :', error.message);
  }
}

function enforceDailyQuota(req, res, next) {
  const userId = req.user && req.user.id;
  if (!Number.isSafeInteger(userId) || userId < 1) {
    return res.status(401).json({ error: 'Connexion requise.' });
  }

  // La Côte d'Ivoire est en UTC : cette date change à minuit local.
  // Les administrateurs ne consomment pas de quota journalier.
  if (req.user.role === 'admin') return next();

  const day = new Date().toISOString().slice(0, 10);
  let kind;

  try {
    db.exec('BEGIN IMMEDIATE');

    db.prepare(`
      INSERT OR IGNORE INTO daily_usage (user_id, usage_date)
      VALUES (?, ?)
    `).run(userId, day);

    const usage = db.prepare(`
      SELECT free_used FROM daily_usage
      WHERE user_id = ? AND usage_date = ?
    `).get(userId, day);

    if (usage.free_used < 3) {
      db.prepare(`
        UPDATE daily_usage SET free_used = free_used + 1
        WHERE user_id = ? AND usage_date = ?
      `).run(userId, day);
      kind = 'free';
    } else {
      const credit = db.prepare(
        'SELECT credits FROM reward_credits WHERE user_id = ?'
      ).get(userId);

      if (!credit || credit.credits < 1) {
        db.exec('ROLLBACK');
        return res.status(429).json({
          code: 'DAILY_LIMIT_REACHED',
          error: 'Tes 3 analyses gratuites du jour sont utilisées. Une publicité récompensée validée sera nécessaire pour obtenir une analyse supplémentaire.'
        });
      }

      db.prepare(
        'UPDATE reward_credits SET credits = credits - 1 WHERE user_id = ?'
      ).run(userId);
      db.prepare(`
        UPDATE daily_usage SET rewarded_used = rewarded_used + 1
        WHERE user_id = ? AND usage_date = ?
      `).run(userId, day);
      kind = 'rewarded';
    }

    db.exec('COMMIT');
  } catch (error) {
    try { db.exec('ROLLBACK'); } catch {}
    console.error('Erreur compteur quotidien :', error.message);
    return res.status(500).json({ error: 'Vérification du quota impossible.' });
  }

  // Une analyse échouée ne consomme pas l'utilisation réservée.
  let released = false;
  res.on('finish', () => {
    if (!released && res.statusCode >= 400) {
      released = true;
      releaseAnalysisQuota(userId, day, kind);
    }
  });

  next();
}

function requireAdmin(req, res, next) {
  if (req.user?.role !== 'admin') {
    return res.status(403).json({ error: 'Accès réservé aux administrateurs.' });
  }
  next();
}

function attachAuth(app) {
  app.post('/api/register', authLimiter, async (req, res) => {
    const phone = String(req.body?.phone || '').replace(/[\s().-]/g, '');
    const password = req.body?.password;

    if (!/^\+?[1-9]\d{7,14}$/.test(phone)) {
      return res.status(400).json({
        error: 'Entre un numéro international valide, par exemple +2250700000000.'
      });
    }
    if (typeof password !== 'string' || password.length < 8 || password.length > 128) {
      return res.status(400).json({
        error: 'Le mot de passe doit contenir entre 8 et 128 caractères.'
      });
    }

    try {
      const hash = await bcrypt.hash(password, 12);
      const result = db.prepare(
        'INSERT INTO users (phone, password_hash) VALUES (?, ?)'
      ).run(phone, hash);
      issueSession(res, { id: Number(result.lastInsertRowid), phone });
      return res.status(201).json({ ok: true, phone });
    } catch (err) {
      if (String(err.code || '').includes('SQLITE_CONSTRAINT')) {
        return res.status(409).json({ error: 'Ce numéro possède déjà un compte.' });
      }
      console.error('Erreur inscription :', err.message);
      return res.status(500).json({ error: 'Impossible de créer le compte.' });
    }
  });

  app.post('/api/login', authLimiter, async (req, res) => {
    const phone = String(req.body?.phone || '').replace(/[\s().-]/g, '');
    const password = req.body?.password;

    if (!/^\+?[1-9]\d{7,14}$/.test(phone) ||
        typeof password !== 'string' || password.length > 128) {
      return res.status(400).json({ error: 'Numéro ou mot de passe invalide.' });
    }

    try {
      const user = db.prepare(
        'SELECT id, phone, password_hash FROM users WHERE phone = ?'
      ).get(phone);
      const valid = user && await bcrypt.compare(password, user.password_hash);

      if (!valid) {
        return res.status(401).json({ error: 'Numéro ou mot de passe incorrect.' });
      }

      issueSession(res, user);
      return res.json({ ok: true, phone: user.phone });
    } catch (err) {
      console.error('Erreur connexion :', err.message);
      return res.status(500).json({ error: 'Connexion momentanément impossible.' });
    }
  });

  app.get('/api/me', requireAuth, (req, res) => {
    res.json({
      authenticated: true,
      phone: req.user.phone,
      role: req.user.role
    });
  });

  // Tableau de bord : liste des comptes, sans jamais exposer les mots de passe.
  app.get('/api/admin/users', requireAuth, requireAdmin, (req, res) => {
    try {
      const day = new Date().toISOString().slice(0, 10);
      const users = db.prepare(`
        SELECT
          u.id, u.phone, u.role, u.created_at,
          COALESCE(d.free_used, 0) AS free_used,
          COALESCE(d.rewarded_used, 0) AS rewarded_used
        FROM users u
        LEFT JOIN daily_usage d
          ON d.user_id = u.id AND d.usage_date = ?
        ORDER BY u.id ASC
      `).all(day);

      res.set('Cache-Control', 'no-store');
      return res.json({ users });
    } catch (error) {
      console.error('Erreur liste admin :', error.message);
      return res.status(500).json({ error: 'Impossible de charger les utilisateurs.' });
    }
  });

  // Seul un administrateur authentifié peut modifier un rôle.
  app.patch('/api/admin/users/:id/role', requireAuth, requireAdmin, (req, res) => {
    const targetId = Number(req.params.id);
    const role = req.body?.role;

    if (!Number.isSafeInteger(targetId) || targetId < 1 ||
        !['user', 'admin'].includes(role)) {
      return res.status(400).json({ error: 'Utilisateur ou rôle invalide.' });
    }

    if (targetId === req.user.id && role !== 'admin') {
      return res.status(400).json({ error: 'Tu ne peux pas retirer ton propre rôle administrateur.' });
    }

    try {
      const target = db.prepare(
        'SELECT id, role FROM users WHERE id = ?'
      ).get(targetId);

      if (!target) {
        return res.status(404).json({ error: 'Utilisateur introuvable.' });
      }

      if (target.role === 'admin' && role === 'user') {
        const admins = db.prepare(
          "SELECT COUNT(*) AS count FROM users WHERE role = 'admin'"
        ).get();

        if (Number(admins.count) <= 1) {
          return res.status(400).json({
            error: 'Impossible de retirer le rôle du dernier administrateur.'
          });
        }
      }

      db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, targetId);
      res.set('Cache-Control', 'no-store');
      return res.json({ ok: true, id: targetId, role });
    } catch (error) {
      console.error('Erreur modification rôle :', error.message);
      return res.status(500).json({ error: 'Impossible de modifier le rôle.' });
    }
  });

  app.post('/api/logout', (req, res) => {
    res.clearCookie(COOKIE, { ...cookieOptions, maxAge: undefined });
    res.json({ ok: true });
  });

  return requireAuth;
}

module.exports = { attachAuth, enforceDailyQuota };
