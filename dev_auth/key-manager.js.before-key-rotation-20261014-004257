// Gestionnaire NVIDIA : rotation round-robin des clés API.
// Les clés sont exclusivement chargées depuis l'environnement du serveur.

const ENV_NAMES = [
  "NVIDIA_API_KEY_1",
  "NVIDIA_API_KEY_2",
  "NVIDIA_API_KEY_3",
  "NVIDIA_API_KEY_4",
];

let nextIndex = 0;
let previousIndex = -1;

// À appeler au démarrage pour détecter les variables manquantes.
function validateKeys() {
  const missing = ENV_NAMES.filter((name) => {
    return !process.env[name] || !process.env[name].trim();
  });

  if (missing.length) {
    throw new Error(
      "Variables NVIDIA manquantes : " + missing.join(", ")
    );
  }
}

// Réserve une clé différente de la dernière clé attribuée.
// L'opération est synchrone et atomique au sein d'un processus Node.js.
function getNextKey() {
  const keys = ENV_NAMES.map((name) => process.env[name]);

  if (keys.some((key) => !key || !key.trim())) {
    throw new Error("Les quatre clés NVIDIA doivent être configurées.");
  }

  let index = nextIndex;

  // Ne pas réutiliser immédiatement la même clé, si possible.
  if (index === previousIndex) {
    index = (index + 1) % keys.length;
  }

  previousIndex = index;
  nextIndex = (index + 1) % keys.length;

  return keys[index];
}

function getStatus() {
  return {
    configured: ENV_NAMES.map((name) => ({
      name,
      configured: Boolean(process.env[name]?.trim()),
    })),
  };
}

module.exports = {
  validateKeys,
  getNextKey,
  getStatus,
};
